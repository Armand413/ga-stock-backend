# Copier les valeurs dans les variables d'environnement du service ou de l'IDE.
# Ne jamais versionner les secrets. Ce fichier n'est pas charge automatiquement.
DB_URL=jdbc:postgresql://localhost:5432/ga
DB_USERNAME=postgres
DB_PASSWORD=
AUTH_MODE=ad
AUTH_SESSION_DURATION=PT15M
AD_DOMAIN=
AD_URL=
AD_BASE_DN=
AD_USER_GROUP_DN=
AD_ADMIN_GROUP_DN=
NOTIFICATION_ADMIN_EMAILS=
MAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
# Seulement pour le developpement avec AUTH_MODE=local :
ADMIN_USERNAME=
ADMIN_NAME=Administrateur GA
ADMIN_PASSWORD=
